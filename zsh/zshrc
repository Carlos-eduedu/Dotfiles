# Managed zsh entry point. Machine-specific settings belong in ~/.zshrc.local.

# Configure Homebrew without spawning `brew shellenv` on every shell startup.
if [[ -x /opt/homebrew/bin/brew ]]; then
  export HOMEBREW_PREFIX=/opt/homebrew
  export HOMEBREW_CELLAR=/opt/homebrew/Cellar
  export HOMEBREW_REPOSITORY=/opt/homebrew
elif [[ -x /usr/local/bin/brew ]]; then
  export HOMEBREW_PREFIX=/usr/local
  export HOMEBREW_CELLAR=/usr/local/Cellar
  export HOMEBREW_REPOSITORY=/usr/local/Homebrew
fi

typeset -U path PATH fpath FPATH
if [[ -n "${HOMEBREW_PREFIX:-}" ]]; then
  path=("$HOMEBREW_PREFIX/bin" "$HOMEBREW_PREFIX/sbin" $path)
  fpath=("$HOMEBREW_PREFIX/share/zsh/site-functions" $fpath)
  _homebrew_info="$HOMEBREW_PREFIX/share/info"
  if [[ ":${INFOPATH:-}:" != *":$_homebrew_info:"* ]]; then
    export INFOPATH="$_homebrew_info:${INFOPATH:-}"
  fi
  unset _homebrew_info
fi
for path_entry in "$HOME/.opencode/bin" "$HOME/.local/bin" "$HOME/bin"; do
  [[ -d "$path_entry" ]] && path=("$path_entry" $path)
done
unset path_entry
export PATH

export LANG="${LANG:-en_US.UTF-8}"
export EDITOR="${EDITOR:-nvim}"
export VISUAL="${VISUAL:-$EDITOR}"
export HOMEBREW_NO_ENV_HINTS=1

export HISTFILE="$HOME/.zsh_history"
export HISTSIZE=20000
export SAVEHIST=20000
setopt APPEND_HISTORY INC_APPEND_HISTORY SHARE_HISTORY EXTENDED_HISTORY
setopt HIST_IGNORE_ALL_DUPS HIST_SAVE_NO_DUPS HIST_FIND_NO_DUPS HIST_REDUCE_BLANKS
setopt AUTO_CD INTERACTIVE_COMMENTS NO_BEEP COMPLETE_IN_WORD ALWAYS_TO_END PUSHD_IGNORE_DUPS

bindkey -v
export KEYTIMEOUT=1
bindkey '^[[A' up-line-or-beginning-search
bindkey '^[[B' down-line-or-beginning-search
autoload -Uz up-line-or-beginning-search down-line-or-beginning-search
zle -N up-line-or-beginning-search
zle -N down-line-or-beginning-search

autoload -Uz compinit
_compdump="${XDG_CACHE_HOME:-$HOME/.cache}/zsh/.zcompdump"
_compdump_check="${_compdump}.last-check"
[[ -d "${_compdump:h}" ]] || mkdir -p "${_compdump:h}"
zmodload zsh/datetime
_compdump_checked=0
[[ -r "$_compdump_check" ]] && _compdump_checked=$(<"$_compdump_check")
if [[ -s "$_compdump" && "$_compdump_checked" == <-> ]] &&
   (( _compdump_checked <= EPOCHSECONDS && EPOCHSECONDS - _compdump_checked < 86400 )); then
  compinit -C -d "$_compdump"
else
  compinit -d "$_compdump"
  zcompile "$_compdump" 2>/dev/null
  print -r -- "$EPOCHSECONDS" >| "$_compdump_check"
fi
unset _compdump _compdump_check _compdump_checked
# Fast first pass, then separator-aware matching and a one-error fallback.
zstyle ':completion:*' completer _complete _match _approximate
zstyle ':completion:*' matcher-list \
  'm:{a-zA-Z}={A-Za-z}' \
  'r:|[._-]=* r:|=*' \
  'l:|=* r:|=*'
zstyle ':completion:*:approximate:*' max-errors 1 numeric

# Group and describe candidates without turning completion into a noisy UI.
zstyle ':completion:*' menu select
zstyle ':completion:*' group-name ''
zstyle ':completion:*' verbose yes
zstyle ':completion:*:descriptions' format '%F{8}-- %d --%f'
zstyle ':completion:*:corrections' format '%F{3}-- %d (errors: %e) --%f'
zstyle ':completion:*:warnings' format '%F{1}-- no matches --%f'
zstyle ':completion:*' list-dirs-first true
zstyle ':completion:*' squeeze-slashes true
zstyle ':completion:*' special-dirs true
zstyle ':completion:*' accept-exact '*(N)'

# Prefer useful directory candidates and keep expensive generated results cached.
zstyle ':completion:*:cd:*' tag-order local-directories directory-stack path-directories
zstyle ':completion:*' use-cache yes
zstyle ':completion:*' cache-path "${XDG_CACHE_HOME:-$HOME/.cache}/zsh"

# Respect an explicit DOTFILES_DIR. Otherwise resolve this file (including a
# symlink such as ~/.zshrc) so the configuration works from any clone path.
if [[ -z "${DOTFILES_DIR:-}" ]]; then
  _dotfiles_entry="${(%):-%N}"
  _dotfiles_entry="${_dotfiles_entry:P}"
  DOTFILES_DIR="${_dotfiles_entry:h:h}"
  # Keep the historic location only as a fallback for unusual source contexts.
  [[ -d "$DOTFILES_DIR/zsh" ]] || DOTFILES_DIR="$HOME/Developer/Dotfiles"
  unset _dotfiles_entry
fi

for module in aliases.zsh functions.zsh integrations.zsh; do
  [[ -r "$DOTFILES_DIR/zsh/$module" ]] && source "$DOTFILES_DIR/zsh/$module"
done
unset module

# Never version this file. It holds machine-specific values such as API keys.
[[ -r "$HOME/.zshrc.local" ]] && source "$HOME/.zshrc.local"

# Keep an absent optional local file from making this entry point return failure.
true
